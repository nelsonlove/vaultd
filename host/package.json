{
  "name": "vaultd-host-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "tsc --build packages/host",
    "typecheck": "tsc --noEmit -p packages/host && tsc --noEmit -p packages/host/tsconfig.test.json",
    "lint": "eslint packages scripts",
    "pretest": "node scripts/warm-fixtures.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.9.2",
    "eslint": "9.39.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.4"
  }
}
