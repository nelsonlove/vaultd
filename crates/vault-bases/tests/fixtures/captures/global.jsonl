{"family": "global", "case": "if:true", "expr": "if(true, \"a\", \"b\")", "kind": "string", "text": "a", "source": "captured"}
{"family": "global", "case": "if:falsy_no_else", "expr": "if(0, \"a\")", "kind": "null", "text": "", "source": "captured"}
{"family": "global", "case": "if:published", "expr": "if(isModified, \"Modified\", \"Unmodified\")", "props": {"isModified": false}, "kind": "string", "text": "Unmodified", "source": "captured"}
{"family": "global", "case": "if:lazy", "expr": "if(true, 1, 1 / 0)", "kind": "number", "text": "1", "source": "captured"}
{"family": "global", "case": "list:wraps", "expr": "list(\"value\")", "kind": "list", "text": "value", "source": "captured"}
{"family": "global", "case": "list:keeps_list", "expr": "list([1, 2])[1]", "kind": "number", "text": "2", "source": "captured"}
{"family": "global", "case": "number:string", "expr": "number(\"3.4\")", "kind": "number", "text": "3.4", "source": "captured"}
{"family": "global", "case": "number:boolean", "expr": "number(true)", "kind": "number", "text": "1", "source": "captured"}
{"family": "global", "case": "number:invalid", "expr": "number(\"abc\")", "kind": "error", "source": "captured"}
{"family": "global", "case": "number:empty_string", "expr": "number(\"\")", "kind": "error", "source": "captured"}
{"family": "global", "case": "number:null", "expr": "number(missing)", "kind": "null", "text": "", "source": "captured"}
{"family": "global", "case": "max:numbers", "expr": "max(1, 5, 3)", "kind": "number", "text": "5", "source": "captured"}
{"family": "global", "case": "min:numbers", "expr": "min(4, -1, 3)", "kind": "number", "text": "-1", "source": "captured"}
{"family": "global", "case": "max:not_a_number", "expr": "max(1, \"a\")", "kind": "error", "source": "captured"}
{"family": "global", "case": "random:range", "expr": "random() >= 0 && random() < 1", "kind": "boolean", "text": "true", "source": "captured"}
{"family": "global", "case": "escapeHTML:five", "expr": "escapeHTML(\"<a href='x'>&\\\"</a>\")", "kind": "string", "text": "&lt;a href='x'&gt;&amp;&quot;&lt;/a&gt;", "source": "captured"}
{"family": "global", "case": "html:kind", "expr": "html(\"<b>x</b>\")", "kind": "html", "text": "<b>x</b>", "source": "captured"}
{"family": "global", "case": "icon:kind", "expr": "icon(\"arrow-right\")", "kind": "icon", "text": "arrow-right", "source": "captured"}
{"family": "global", "case": "image:url", "expr": "image(\"https://obsidian.md/images/obsidian-logo-gradient.svg\")", "kind": "image", "text": "![](https://obsidian.md/images/obsidian-logo-gradient.svg)", "source": "captured"}
{"family": "global", "case": "unknown_function", "expr": "frobnicate(1)", "kind": "error", "source": "captured"}
{"family": "global", "case": "number:infinity_string", "expr": "number(\"Infinity\")", "kind": "number", "text": "Infinity", "source": "captured"}
