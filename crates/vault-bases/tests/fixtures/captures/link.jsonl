{"family": "link", "case": "link", "expr": "link(\"Other\")", "kind": "link", "text": "[[Other]]", "source": "captured"}
{"family": "link", "case": "link:display", "expr": "link(\"Other\", \"display\")", "kind": "link", "text": "[[Other|display]]", "source": "captured"}
{"family": "link", "case": "link:icon_display", "expr": "link(\"Other\", icon(\"plus\"))", "kind": "link", "text": "[[Other|plus]]", "source": "captured"}
{"family": "link", "case": "link:url", "expr": "link(\"https://obsidian.md\")", "kind": "link", "text": "https://obsidian.md", "source": "captured"}
{"family": "link", "case": "link:from_date_string", "expr": "link(file.ctime.date().toString())", "kind": "link", "text": "[[2026-01-14]]", "source": "captured"}
{"family": "link", "case": "asFile", "expr": "link(\"[[Other]]\").asFile().path", "kind": "string", "text": "Other.md", "source": "captured"}
{"family": "link", "case": "asFile:unresolved", "expr": "link(\"Nowhere\").asFile()", "kind": "null", "text": "", "source": "captured"}
{"family": "link", "case": "asFile:url", "expr": "link(\"https://obsidian.md\").asFile()", "kind": "error", "source": "captured"}
{"family": "link", "case": "linksTo", "expr": "link(\"Other\").linksTo(this)", "kind": "boolean", "text": "true", "source": "published"}
{"family": "link", "case": "linksTo:not", "expr": "link(\"Other\").linksTo(file(\"Folder/image.png\"))", "kind": "boolean", "text": "false", "source": "captured"}
{"family": "link", "case": "file:from_link", "expr": "file(link(\"[[Other]]\")).path", "kind": "string", "text": "Other.md", "source": "captured"}
{"family": "link", "case": "file:from_path", "expr": "file(\"Other.md\").name", "kind": "string", "text": "Other", "source": "captured"}
{"family": "link", "case": "file:missing", "expr": "file(\"path to file\")", "kind": "null", "text": "", "source": "captured"}
{"family": "link", "case": "equal:same_file", "expr": "link(\"Other\") == link(\"[[Other]]\")", "kind": "boolean", "text": "true", "source": "captured"}
{"family": "link", "case": "equal:unresolved_same_text", "expr": "link(\"Nowhere\") == link(\"Nowhere\")", "kind": "boolean", "text": "true", "source": "captured"}
{"family": "link", "case": "linksTo:embed", "expr": "link(\"Capture\").linksTo(file(\"Folder/image.png\"))", "kind": "boolean", "text": "false", "source": "captured"}
{"family": "link", "case": "equal:file", "expr": "link(\"Other\") == file(\"Other.md\")", "kind": "boolean", "text": "true", "source": "captured"}
